          "legendFormat": "P95 {{model}}",
          "range": true,
          "refId": "B"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Token 吞吐（输入 / 输出）",
      "description": "aligo_model_tokens_total 按 direction 分组。这是**成本面板的数据源** —— 计费按 token 算，而 token 数与请求数不成正比（一次长上下文请求可能抵几十次短请求）。\n\n⚠️ 在零密钥（MockLLM）环境下这里会有数据但数值是估算的：Mock 按字符数折算 token，不接真实的 tokenizer。它的用途是验证**这条链路是通的**，不是用来估成本的。",
      "datasource": { "type": "prometheus", "uid": "aligo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
